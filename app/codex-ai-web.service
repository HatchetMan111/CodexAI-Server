[Unit]
Description=Codex Web-Terminal (ttyd auf tmux 'codex')
Documentation=https://github.com/HatchetMan111/CodexAI-Server
After=network-online.target codex-ai-session.service
Wants=network-online.target

[Service]
# Port und Passwort: __PORT__ / __WEB_PASSWORD__ (vom Installer ersetzt).
# -W = schreibbar (Eingabe im Browser), -c = Basic-Auth für das Root-Terminal.
ExecStart=/usr/local/bin/ttyd -p __PORT__ -c codex:__WEB_PASSWORD__ -W /usr/bin/tmux attach -t codex
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
