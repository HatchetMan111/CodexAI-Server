#!/usr/bin/env bash
# Mock: curl – stellt Test-Assets bereit; HTTP-Checks gegen den systemd-State.
set -uo pipefail

STATE="${HARNESS_STATE:?HARNESS_STATE fehlt}"
mkdir -p "$STATE/curl-calls"

out=""
url=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
    a="${args[$i]}"
    case "$a" in
        -o | --output)
            out="${args[$((i + 1))]:-}"
            i=$((i + 1))
            ;;
        -*) ;;
        *) url="$a" ;;
    esac
done
echo "$url" >> "$STATE/curl-calls/urls.log"

case "$url" in
    *codeload.github.com*)
        [[ -n "$out" ]] || { echo "mock-curl: -o fehlt (codeload)" >&2; exit 1; }
        cp "${HARNESS_SRC_TARBALL:?HARNESS_SRC_TARBALL fehlt}" "$out"
        ;;
    *chatgpt.com/codex/install.sh*)
        # Offizieller Standalone-Installer: Mock-Bootstrap auf stdout pipen
        # (wird von `| env CODEX_RELEASE=... sh` ausgeführt).
        cat "${HARNESS_ASSETS:?}/mock-codex-bootstrap.sh"
        ;;
    *nodejs.org/dist/latest-v22.x/SHASUMS256.txt)
        [[ -n "$out" ]] || { echo "mock-curl: -o fehlt (node-shasums)" >&2; exit 1; }
        cp "${HARNESS_NODE_SHASUMS:?HARNESS_NODE_SHASUMS fehlt}" "$out"
        ;;
    *nodejs.org/dist/latest-v22.x/*linux-x64.tar.gz)
        [[ -n "$out" ]] || { echo "mock-curl: -o fehlt (node-tarball)" >&2; exit 1; }
        cp "${HARNESS_NODE_TARBALL:?HARNESS_NODE_TARBALL fehlt}" "$out"
        ;;
    *ttyd/releases/download/*ttyd.x86_64)
        [[ -n "$out" ]] || { echo "mock-curl: -o fehlt (ttyd)" >&2; exit 1; }
        # Gleiche Quelle wie die SHA256SUMS-Zeile unten → Checksumme stimmt.
        cp "${HARNESS_ASSETS:?}/mock-ttyd.sh" "$out"
        chmod +x "$out"
        ;;
    *ttyd/releases/download/*SHA256SUMS)
        [[ -n "$out" ]] || { echo "mock-curl: -o fehlt (SHA256SUMS)" >&2; exit 1; }
        sum=$(sha256sum "${HARNESS_ASSETS:?}/mock-ttyd.sh" | awk '{print $1}')
        printf '%s  ttyd.x86_64\n' "$sum" > "$out"
        ;;
    http://127.0.0.1:*)
        # Web-Terminal-Check (Port 8091): 200 wenn codex-ai-web aktiv ist
        if [[ "$url" == *":8091"* ]]; then
            if [[ -f "$STATE/systemd/codex-ai-web.service.active" ]]; then
                printf '200'
            else
                printf '000'
            fi
        # Web-UI-Check (Port 8092): 200 wenn codex-ai-ui aktiv ist
        elif [[ "$url" == *":8092"* ]]; then
            if [[ -f "$STATE/systemd/codex-ai-ui.service.active" ]]; then
                printf '200'
            else
                printf '000'
            fi
        else
            printf '200'
        fi
        ;;
    *)
        echo "mock-curl: unerwartete URL: $url" >&2
        exit 6
        ;;
esac
