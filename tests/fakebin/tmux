#!/usr/bin/env bash
# Mock: tmux – state-basiert (Session vorhanden ja/nein).
set -uo pipefail

STATE="${HARNESS_STATE:?HARNESS_STATE fehlt}"
LOG="$STATE/tmux-calls.log"

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
echo "tmux $cmd $*" >> "$LOG"

case "$cmd" in
    new-session) echo 1 > "$STATE/tmux.session" ;;
    kill-session) echo 0 > "$STATE/tmux.session" ;;
    has-session)
        if [[ "$(cat "$STATE/tmux.session" 2>/dev/null || echo 0)" == "1" ]]; then
            exit 0
        fi
        exit 1
        ;;
    attach) ;;
    *) ;;
esac
exit 0
