#!/usr/bin/env bash
# Mock: systemctl – state-basiert; startet codex-ai-session simuliert
# (Effekt der ExecStart-Zeile: tmux-Session anlegen).
set -uo pipefail

STATE="${HARNESS_STATE:?HARNESS_STATE fehlt}"
mkdir -p "$STATE/systemd"

cmd="${1:-}"
[[ $# -gt 0 ]] && shift

quiet=false
now=false
units=()
for a in "$@"; do
    case "$a" in
        --quiet | -q) quiet=true ;;
        --now) now=true ;;
        --no-pager) ;;
        -*) ;;
        *) units+=("$a") ;;
    esac
done

mark_session_up() {
    {
        echo "tmux kill-session -t codex  (ExecStartPre, simuliert)"
        echo "tmux new-session -d -s codex -c /root/codex-workspace /opt/codex-ai/session.sh  (ExecStart, simuliert)"
    } >> "$STATE/tmux-calls.log"
    echo 1 > "$STATE/tmux.session"
}
mark_session_down() {
    echo "tmux kill-session -t codex  (ExecStop, simuliert)" >> "$STATE/tmux-calls.log"
    echo 0 > "$STATE/tmux.session"
}

case "$cmd" in
    daemon-reload)
        touch "$STATE/systemd/.daemon-reloaded"
        ;;
    enable)
        for u in "${units[@]}"; do
            touch "$STATE/systemd/$u.enabled"
            if $now; then
                touch "$STATE/systemd/$u.active"
                [[ "$u" == "codex-ai-session.service" ]] && mark_session_up
            fi
        done
        ;;
    restart | start)
        for u in "${units[@]}"; do
            touch "$STATE/systemd/$u.active"
            if [[ "$u" == "codex-ai-session.service" ]]; then
                mark_session_up
            elif [[ "$u" == "codex-ai-web.service" ]]; then
                touch "$STATE/systemd/codex-ai-web.service.active"
            fi
        done
        ;;
    stop)
        for u in "${units[@]}"; do
            rm -f "$STATE/systemd/$u.active"
            [[ "$u" == "codex-ai-session.service" ]] && mark_session_down
        done
        ;;
    is-active)
        u="${units[0]:-}"
        if [[ -n "$u" && -f "$STATE/systemd/$u.active" ]]; then
            $quiet || echo "active"
            exit 0
        fi
        $quiet || echo "inactive"
        exit 3
        ;;
    journalctl)
        echo "mock-systemctl-journal"
        ;;
    *)
        echo "mock-systemctl: unbekannter Befehl: $cmd" >&2
        exit 64
        ;;
esac
exit 0
